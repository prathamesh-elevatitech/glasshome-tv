<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pratham.tvhome"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="31" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Aerial screensaver streams its videos. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Control Center shows the Wi-Fi network name (location is granted by install.sh). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- App Switcher: recent apps, and closing them. Usage access is granted by install.sh. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Granted over adb so the home screen can re-enable the remote-button service. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:label="Home"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:largeHeap="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>



        <service
            android:name=".KeyService"
            android:exported="true"
            android:label="Home Control Center"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>

        <activity
            android:name=".AerialActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape" />

        <activity
            android:name=".AppearanceSettings"
            android:exported="false"
            android:theme="@style/PanelTheme"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ControlCenterSettings"
            android:exported="false"
            android:theme="@style/PanelTheme"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ScreenSaverSettings"
            android:exported="false"
            android:theme="@style/PanelTheme"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape" />

        <service
            android:name=".AerialDream"
            android:exported="true"
            android:label="Aerials"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Lets Control Center read Now Playing; enabled by install.sh. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="Home Now Playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".ClockDream"
            android:exported="true"
            android:label="Clock"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
